# Copy to .env for local development. Do not commit real secrets.

# Option A: direct API key for private local use only.
# RESEND_API_KEY=replace-with-your-resend-api-key

# Option B: 1Password reference resolved by `op run --env-file=.env -- ...`.
# Keep public examples generic; do not commit personal vault/item paths.
# RESEND_API_KEY=op://your-vault/your-item/resend_api_key

# Default sender for this local install.
RESEND_FROM_EMAIL="Your App <no-reply@example.com>"

# Optional receiving address for live/e2e tests.
RESEND_RECEIVING_ADDRESS=anything@example.resend.app

# Optional local data directory.
RESEND_DATA_DIR=data
